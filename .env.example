# Copy to .env and fill in what you have. Everything is optional except where noted.
# Never commit .env.

# ---- LLM (scripts, SEO, topic brainstorming, analytics) ----
# Without a key the app uses an offline extractive template (basic, for testing only).
LLM_PROVIDER=auto                 # auto | anthropic | openai | gemini | offline
ANTHROPIC_API_KEY=                # https://console.anthropic.com -> API Keys (recommended)
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=                   # optional alt LLM + OpenAI TTS + OpenAI images
OPENAI_MODEL=gpt-4.1
# Free option: Google Gemini API key from https://aistudio.google.com/apikey (free tier, daily limits,
# lower script quality than Claude). Used only for text, not for voice or images.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Voice ----
TTS_PROVIDER=edge                 # edge (free, no key) | elevenlabs | openai | espeak (offline, robotic)
TTS_FALLBACKS=edge,espeak
EDGE_VOICE=en-US-ChristopherNeural   # alternatives: en-US-GuyNeural, en-US-EricNeural, en-US-RogerNeural
EDGE_RATE=-6%
EDGE_PITCH=-6Hz
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # pick a deep documentary narrator voice in the ElevenLabs Voice Library
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# ---- Visuals ----
# Tried in order per scene. Only verified reusable licenses are accepted.
IMAGE_PROVIDERS=wikimedia,pexels,openai,procedural
PEXELS_API_KEY=                   # https://www.pexels.com/api/ (free)
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Research ----
YOUTUBE_API_KEY=                  # Google Cloud -> APIs & Services -> Credentials -> API key (YouTube Data API v3)
USE_YOUTUBE_AUTOCOMPLETE=true

# ---- YouTube upload + analytics (OAuth) ----
GOOGLE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
DEFAULT_PRIVACY=private           # private | unlisted. Public only via dashboard approval.
CONTAINS_SYNTHETIC_MEDIA=true     # YouTube altered/synthetic content disclosure

# ---- Storage / worker ----
DATA_DIR=data
JOB_MAX_ATTEMPTS=3
